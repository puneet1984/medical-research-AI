# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# LLM Provider Preference: 'auto', 'omniroute', 'ollama', 'openrouter', or 'gemini'
LLM_PROVIDER="auto"

# Ollama Local / Remote Configuration (URL & models)
OLLAMA_URL="http://localhost:11434"
OLLAMA_LLM_MODEL="llama3:latest"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# OmniRoute Unified Router / OpenAI-Compatible Proxy (Optional)
# OMNIROUTE_URL="https://api.omniroute.ai/v1"
# OMNIROUTE_API_KEY="your_omniroute_api_key_here"
OMNIROUTE_LLM_MODEL="deepseek/deepseek-r1"

# OpenRouter Configuration (Inference & Embeddings)
# OPENROUTER_API_KEY="your_openrouter_api_key_here"
LLM_REASONING_MODEL="deepseek/deepseek-r1"
LLM_SYNTHESIS_MODEL="meta-llama/llama-3.3-70b-instruct"
OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"

# Hugging Face Configuration (Alternative Embeddings)
# HUGGINGFACE_API_KEY="your_huggingface_api_key_here"
HUGGINGFACE_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Embedding Provider: 'auto', 'ollama', 'openrouter', 'huggingface', or 'local'
EMBEDDING_PROVIDER="auto"

# Optional External Qdrant Vector Database
QDRANT_HOST="localhost"
QDRANT_PORT="6333"
QDRANT_URL="http://localhost:6333"
# QDRANT_API_KEY=""

# Contact email for polite PubMed and OpenAlex queries (NCBI NBK25497 requirement)
SCHOLARLY_USER_AGENT_EMAIL="researcher@domain.com"

# Optional NCBI Entrez API Key (enables up to 10 req/s under NBK25497 guidelines; 3 req/s without key)
# NCBI_API_KEY="your_ncbi_entrez_api_key_here"
